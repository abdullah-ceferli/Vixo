# Copy this template to .env. Commit only this example, never .env.
# Docker Compose reads MYSQL_* below and builds its internal DATABASE_URL.
# Set strong, unique passwords before initializing a NEW Docker database.
# Use URL-safe passwords (letters, numbers, _ and -) because the app uses a URL.
MYSQL_DATABASE="Vixo"
MYSQL_USER="vixo"
MYSQL_PASSWORD="replace_with_a_long_unique_password"
MYSQL_ROOT_PASSWORD="replace_with_a_different_long_unique_password"

# These two URLs are for npm execution OUTSIDE Docker only.
# They must point to your separately configured host MySQL and Redis services.
DATABASE_URL="mysql://vixo:replace_with_a_long_unique_password@127.0.0.1:3306/Vixo"
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_APP_URL="http://127.0.0.1:5173"
SESSION_COOKIE_NAME="vixo_session"
SESSION_TTL_DAYS="30"
# Set true when every public access path uses HTTPS with a stable hostname.
SESSION_COOKIE_SECURE="false"
MAX_UPLOAD_BYTES="10737418240"
UPLOAD_CHUNK_BYTES="8388608"
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
HLS_SEGMENT_SECONDS="4"
VIDEO_CRF="22"
VIDEO_PRESET="medium"
WORKER_CONCURRENCY="1"
DELETE_SOURCE_AFTER_TRANSCODE="false"
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./storage"
# S3-compatible storage (MinIO defaults shown). Used when STORAGE_DRIVER=s3.
# Docker: http://minio:9000. Native npm setup: http://127.0.0.1:9000.
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_BUCKET="vixo"
S3_ACCESS_KEY="vixo"
S3_SECRET_KEY="replace_with_a_long_unique_minio_password"
S3_FORCE_PATH_STYLE="true"

# Optional named tunnel; leave empty for the existing Quick Tunnel command.
# Used only by compose.tunnel.yml. Get the token from your Cloudflare account.
CLOUDFLARE_TUNNEL_TOKEN=""
